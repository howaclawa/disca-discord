{
  "name": "disca",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "cd .. && pi -e ./discord-plumbing/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "knip": "knip",
    "test": "bun test",
    "check": "bun run lint && bun run typecheck && bun run knip && bun test"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "dependencies": {
    "@howaboua/pi-codex-conversion": "3.0.27",
    "discord.js": "14.26.5",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@earendil-works/pi-agent-core": "0.85.0",
    "@earendil-works/pi-ai": "0.85.0",
    "@earendil-works/pi-coding-agent": "0.85.0",
    "@earendil-works/pi-server": "0.85.0",
    "@earendil-works/pi-tui": "0.85.0",
    "@types/bun": "1.3.14",
    "@types/node": "26.1.1",
    "knip": "6.26.0",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.0"
}
