# Copy to .env and fill in. Never commit the real one.
DISCORD_BOT_TOKEN=paste-bot-token-here

# mentions: bot mentions, replies, or a configured trigger alias
# channels: every message in ALLOWED_CHANNEL_IDS
# all: every message outside EXCLUDED_CHANNEL_IDS
# A non-empty ALLOWED_CHANNEL_IDS restricts guild intake under every policy.
CHANNEL_POLICY=mentions
TRIGGER_ALIASES=disca
# Bot presence. Picked up on restart.
DISCORD_STATUS_TEXT=the room
DISCORD_STATUS_TYPE=Watching
ALLOWED_CHANNEL_IDS=
EXCLUDED_CHANNEL_IDS=

# false keeps the Discord wire visible without starting Pi turns.
DISCORD_CHAT_ENABLED=true
# While armed, a fresh random count in this range wakes Disca into ambient room life.
AMBIENT_WAKE_MIN_MESSAGES=5
AMBIENT_WAKE_MAX_MESSAGES=20
DISCORD_ACTIVITY_LINES=6

# Empty accepts every Discord user.
ALLOWED_USER_IDS=

# `discord_send` with channel `dm` sends here.
DEFAULT_DM_USER_ID=paste-your-discord-user-id

RECENT_CONTEXT_MESSAGES=8
MAX_QUEUE=50
MAX_ATTACHMENT_BYTES=10485760
MAX_TOTAL_ATTACHMENT_BYTES=26214400
ATTACHMENT_RETENTION_DAYS=7
